TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: getrennte Chats für Besuche und SEO-Berichte
TELEGRAM_VISIT_CHAT_ID=
TELEGRAM_SEO_CHAT_ID=

# Schutz für https://domain.tld/seo-cockpit
SEO_DASHBOARD_USER=
SEO_DASHBOARD_PASSWORD=
SEO_SYNC_SECRET=
