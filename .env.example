# Google Search Console Service Account
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY_BASE64=
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:plessing-consulting.com
